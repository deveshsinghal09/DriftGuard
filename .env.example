# Bind to loopback for local development.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Relative paths are resolved from the working directory.
DATABASE_PATH=.driftguard/driftguard.sqlite

# Comma-separated HTTP(S) origins, e.g. http://localhost:5173. Empty disables CORS.
CORS_ORIGINS=

# Optional loopback-only Phase 1 workflow. Provide a different token for each role.
# Generate each token with Node's crypto.randomBytes(32).toString('base64url').
WORKFLOW_OWNER_TOKEN=
WORKFLOW_GUARDIAN_TOKEN=
WORKFLOW_BUILDER_TOKEN=
WORKFLOW_VERIFIER_TOKEN=
# Comma-separated owner/repo names. Keep empty for role-only smoke tests.
WORKFLOW_ALLOWED_REPOS=
